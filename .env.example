DO_INFERENCE_API_KEY=replace-with-your-model-access-key
# DigitalOcean control-plane token for native Evaluations (GenAI read/write):
# DIGITALOCEAN_TOKEN=replace-with-your-scoped-personal-access-token
# Optional per-model cutoff in seconds (default: 30; allowed: 1-300):
# DO_INFERENCE_TIMEOUT=30
# Optional compatible endpoint override:
# DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
# Optional native evaluation settings:
# DO_EVAL_DATASET_UUID=reuse-an-already-uploaded-15-prompt-dataset
# DO_EVAL_JUDGE_MODEL=qwen3.5-397b-a17b
# DO_EVAL_METRICS=correctness,completeness
# DO_EVAL_TIMEOUT=600
